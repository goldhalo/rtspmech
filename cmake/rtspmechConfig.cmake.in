@PACKAGE_INIT@

# -----------------------------------------------------------------------------
#  rtspmechConfig.cmake —— find_package(rtspmech) 的入口
# -----------------------------------------------------------------------------
#  用法：
#      find_package(rtspmech REQUIRED)
#      target_link_libraries(app PRIVATE rtspmech::rtspmech)
#
#  需要先有 netmech 包：rtspmech 的公共头不 include netmech（只前向声明），
#  但实现链接 netmech，导出的 target 带着 netmech::netmech。
# -----------------------------------------------------------------------------

include(CMakeFindDependencyMacro)

find_dependency(netmech)

include("${CMAKE_CURRENT_LIST_DIR}/rtspmechTargets.cmake")

check_required_components(rtspmech)
